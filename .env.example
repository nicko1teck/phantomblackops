# Phantom Black Ops settings. Copy this file to ".env" and fill in your values.
PORT=3000

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=henrysimfdb

# Your agent name - this account becomes the Director (logs in with password, approves new agents)
DIRECTOR=YourAgentName

# The math practice site's domain(s), comma-separated. That domain only ever shows the
# math page (course code login + scratch pad), never anything else from this app.
# MATH_HOSTS=example-math-site.com,www.example-math-site.com
